# Copy to .env and fill in. Never commit .env.

# development | test | production
NODE_ENV=development

PORT=5050
# 0.0.0.0 lets a physical phone on the same Wi-Fi reach http://<LOCAL-PC-IP>:5050/api/v1
HOST=0.0.0.0

# Local MongoDB only for current development (no Atlas or other remote database).
MONGODB_URI=mongodb://127.0.0.1:27017/dating_cloud

# Public base URL of this API. Used to build absolute URLs for uploaded images.
APP_URL=http://127.0.0.1:5050

# Admin panel origin(s) allowed by CORS, comma-separated (CLIENT_URL is accepted as an older alias).
# In development http://127.0.0.1:5173 and http://localhost:5173 are always allowed.
# In production only these origins are allowed (required).
ADMIN_URL=http://127.0.0.1:5173

# Folder for uploaded images, relative to backend/ (local fallback when Cloudinary is off / tests).
UPLOADS_DIR=uploads

# Cloudinary — required in production. All three must be set together.
# Dashboard: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Version of the Terms of Service members must accept during onboarding.
TERMS_VERSION=2026-01

# First admin account, created by: npm run seed:admin
# Use a real email and a strong password (10–128 characters). Never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production refuses placeholder or short (< 32 chars) secrets.
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# TEMPORARY development/testing behaviour: no SMS is sent and every code is FIXED_OTP.
# Production refuses OTP_MODE=fixed unless ALLOW_FIXED_OTP=true is set deliberately.
OTP_MODE=fixed
FIXED_OTP=123456
ALLOW_FIXED_OTP=false
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=30

# Number of reverse proxies in front of the API (0 = none). Set to 1 on Render for correct client IPs.
TRUST_PROXY=0
